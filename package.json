{
  "name": "vbs-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Veerabhadra Swami Challagali's portfolio, built three ways with three.js.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:github": "node scripts/sync-github.mjs",
    "sync:shots": "node scripts/fetch-screenshots.mjs",
    "posters": "node scripts/capture-posters.mjs",
    "film:art": "node scripts/print-film-plates.mjs",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/chivo-mono": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/league-gothic": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/monaspace-neon": "5.3.0",
    "astro": "7.4.13",
    "lenis": "1.3.27",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/three": "0.187.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
