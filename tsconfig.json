{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@site": ["site.config.ts"],
      "@default-page": ["src/variants/film/Page.astro"]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"]
}
