---
/**
 * The root address shows the build named by `defaultVariant` in site.config.ts.
 * Every build also keeps its own address: /film/, /phone/, /manual/, /classic/.
 * Only the default build is imported (the `@default-page` alias in astro.config.mjs), so only its
 * stylesheet ships here: importing every build and picking one loads all four stylesheets onto one page.
 */
import Page from '@default-page';
---

<Page />
