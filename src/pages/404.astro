---
import BaseHead from '@/components/shared/BaseHead.astro';
import { variantMeta } from '@site';
import { profile } from '@/content';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead variant="phone" title={`Page not found · ${profile.name}`} description="That address does not exist on this site." />
    <meta name="robots" content="noindex" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: var(--c-bg);
        color: var(--c-text);
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      main {
        max-width: 34rem;
      }
      h1 {
        margin: 0 0 0.5rem;
        font-size: clamp(2rem, 7vw, 3rem);
        line-height: 1.05;
      }
      ul {
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.5rem;
        margin: 1.25rem 0 0;
      }
      a {
        color: var(--c-primary);
        font-weight: 600;
      }
      a:focus-visible {
        outline: 3px solid var(--c-primary);
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>This page does not exist.</h1>
      <p>The address may be mistyped, or the page may have moved. The portfolio is at these addresses:</p>
      <ul>
        <li><a href="/">Home</a></li>
        {Object.values(variantMeta).map((v) => <li><a href={v.path}>{v.name}</a>: {v.blurb.toLowerCase()}</li>)}
      </ul>
    </main>
  </body>
</html>
