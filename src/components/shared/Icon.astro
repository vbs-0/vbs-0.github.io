---
import { type IconName, icons } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Leave empty for decorative icons; they are hidden from assistive technology. */
  label?: string;
}
const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
